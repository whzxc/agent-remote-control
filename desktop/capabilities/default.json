{
  "identifier": "main",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "codex://*" },
        { "url": "vscode://*" },
        { "url": "vscode-insiders://*" },
        { "url": "cursor://*" },
        { "url": "zed://*" }
      ]
    },
    "notification:default",
    "window-state:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-fullscreen",
    "clipboard-manager:allow-write-text"
  ]
}
