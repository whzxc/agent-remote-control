{
  "bundle": {
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "template": "installer/installer.nsi",
        "installerHooks": "installer/pages.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ARC",
        "width": 840,
        "height": 578,
        "minWidth": 800,
        "minHeight": 578,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#ffffff",
        "decorations": true
      }
    ]
  }
}
