{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "adg",
    "noEmit": true,
    "strict": true,
    "paths": {
      "adg": ["./.adg/runtime.d.ts"],
      "adg/jsx-runtime": ["./.adg/runtime.d.ts"]
    }
  },
  "include": ["**/*.tsx", "**/*.ts", ".adg/*.d.ts"]
}
