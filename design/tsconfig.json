{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "adg": ["./.adg/runtime.d.ts"],
      "@/*": ["../ui/*"]
    }
  },
  "include": ["**/*.tsx", "**/*.ts", ".adg/*.d.ts"]
}
