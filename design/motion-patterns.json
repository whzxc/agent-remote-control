{
  "version": 1,
  "ignore": [
    {
      "file": "assets/promo/promo.html",
      "match": "web:requestAnimationFrame",
      "reason": "Previews the standalone promotional video on its authored timeline outside the product UI."
    },
    {
      "file": "tooling/acceptance/families/timeline.mjs",
      "match": "web:requestAnimationFrame",
      "within": "sample",
      "reason": "Waits for the visible timeline and reads its initial scroll position for acceptance."
    },
    {
      "file": "tooling/acceptance/families/timeline.mjs",
      "match": "web:requestAnimationFrame",
      "within": "run",
      "reason": "Starts the acceptance sampler for the initial timeline scroll position."
    }
  ],
  "roles": {
    "duration-base": "--motion-base",
    "duration-fast": "--motion-fast",
    "duration-loop": "--motion-running",
    "easing-enter": "--ease-enter",
    "easing-exit": "--ease-exit",
    "easing-loop": "--ease-running",
    "spring-small": "--motion-spring-topology",
    "distance-small": "--motion-distance-update",
    "scale-small": "--motion-scale-small"
  },
  "patterns": {
    "aurora-border": {
      "kind": "ambient",
      "action": "loop",
      "effect": "aurora",
      "properties": [
        "--task-aurora-angle",
        "background"
      ],
      "parameters": {
        "duration": "--motion-aurora",
        "easing": "--ease-linear"
      },
      "interrupt": "cancel",
      "reduced": "static",
      "frames": [
        {
          "source": "design/components/task-card.tsx",
          "frame": "task-card-aurora"
        }
      ],
      "consumers": [
        {
          "file": "ui/components/ui/TaskCard.css",
          "match": "css:.task-card[data-aurora]"
        },
        {
          "file": "ui/components/ui/TaskCard.css",
          "match": "keyframes:task-aurora"
        },
        {
          "file": "ui/components/ui/TaskCard.tsx",
          "match": "attribute:data-aurora"
        }
      ]
    },
    "geometry-transition": {
      "extends": "size-transition",
      "consumers": [
        {
          "file": "ui/motion/geometry.ts",
          "match": "motion:animate",
          "within": "to"
        }
      ]
    },
    "topology-geometry-spring": {
      "extends": "size-transition",
      "parameters": {
        "spring": "--motion-spring-topology"
      },
      "frames": [
        {
          "source": "design/modules/homepage-scene/index.tsx",
          "frame": "idle"
        },
        {
          "source": "design/modules/homepage-scene/index.tsx",
          "frame": "capsule"
        }
      ],
      "consumers": [
        {
          "file": "ui/topology/animate.ts",
          "match": "call:spring",
          "within": "TopologyAnimator"
        },
        {
          "file": "ui/topology/Topology.tsx",
          "match": "web:requestAnimationFrame",
          "within": "tick"
        },
        {
          "file": "ui/topology/Topology.tsx",
          "match": "web:requestAnimationFrame",
          "within": "wake"
        },
        {
          "file": "ui/components/ui/NodeCapsule.tsx",
          "match": "web:requestAnimationFrame",
          "within": "step"
        },
        {
          "file": "ui/components/ui/NodeCapsule.tsx",
          "match": "web:requestAnimationFrame",
          "within": "NodeCapsule"
        }
      ]
    },
    "appear": {
      "extends": "fade",
      "parameters": {
        "duration": "--motion-fast"
      },
      "consumers": [
        {
          "file": "ui/components/ui/controls.css",
          "match": "css:.select-content,.menu,.popover"
        },
        {
          "file": "ui/components/ui/controls.css",
          "match": "css:.tooltip"
        },
        {
          "file": "ui/style.css",
          "match": "keyframes:appear"
        }
      ]
    },
    "quota-fade": {
      "extends": "fade",
      "frames": [
        {
          "source": "design/modules/quota-detail.tsx",
          "frame": "history"
        }
      ],
      "consumers": [
        {
          "file": "ui/subscriptions/bubble.css",
          "match": "css:.history-popover"
        },
        {
          "file": "ui/subscriptions/bubble.css",
          "match": "keyframes:quota-fade"
        }
      ]
    },
    "source-grow-in": {
      "extends": "spring-pop",
      "parameters": {
        "duration": "--motion-base",
        "easing": "--ease-enter",
        "fromOpacity": 0.3
      },
      "frames": [
        {
          "source": "design/modules/homepage-scene/index.tsx",
          "frame": "idle"
        }
      ],
      "consumers": [
        {
          "file": "ui/product.css",
          "match": "keyframes:source-grow-in"
        },
        {
          "file": "ui/product.css",
          "match": "css:.graph-node[data-new-source]"
        }
      ]
    },
    "capsule-pulse": {
      "extends": "ambient-loop",
      "parameters": {
        "scale": "--motion-scale-still",
        "fromOpacity": 0.45
      },
      "frames": [
        {
          "source": "design/modules/homepage-scene/index.tsx",
          "frame": "capsule"
        }
      ],
      "consumers": [
        {
          "file": "ui/components/ui/NodeCapsule.css",
          "match": "css:.node-capsule-disc[data-phase=running]"
        },
        {
          "file": "ui/components/ui/NodeCapsule.css",
          "match": "keyframes:capsule-pulse"
        }
      ]
    },
    "hub-ripple": {
      "kind": "transition",
      "action": "enter",
      "effect": "pulse",
      "properties": [
        "transform",
        "opacity"
      ],
      "parameters": {
        "duration": "--motion-running",
        "easing": "--ease-enter",
        "scale": "--motion-scale-ripple",
        "fromOpacity": 0.45
      },
      "interrupt": "finish",
      "reduced": "instant",
      "frames": [
        {
          "source": "design/modules/homepage-scene/index.tsx",
          "frame": "idle"
        }
      ],
      "consumers": [
        {
          "file": "ui/product.css",
          "match": "css:.hub-entry[data-empty] .hub-dot::after"
        },
        {
          "file": "ui/product.css",
          "match": "keyframes:hub-ripple"
        }
      ]
    },
    "phase-shimmer": {
      "kind": "ambient",
      "action": "loop",
      "effect": "shimmer",
      "properties": [
        "transform"
      ],
      "parameters": {
        "duration": "--motion-running",
        "easing": "--ease-enter"
      },
      "interrupt": "cancel",
      "reduced": "static",
      "frames": [
        {
          "source": "design/modules/homepage-scene/index.tsx",
          "frame": "phase-label"
        }
      ],
      "consumers": [
        {
          "file": "ui/components/ui/TaskPhase.css",
          "match": "css:.phase-shimmer"
        },
        {
          "file": "ui/components/ui/TaskPhase.css",
          "match": "css:.phase-shimmer>span"
        },
        {
          "file": "ui/components/ui/TaskPhase.css",
          "match": "keyframes:phase-shimmer"
        },
        {
          "file": "ui/components/ui/TaskPhase.css",
          "match": "keyframes:phase-shimmer-text"
        }
      ]
    },
    "layer-fade": {
      "kind": "transition",
      "action": "enter",
      "effect": "fade",
      "properties": [
        "opacity",
        "scale"
      ],
      "parameters": {
        "duration": "--motion-base",
        "easing": "--ease-enter"
      },
      "exit": {
        "duration": "--motion-fast",
        "easing": "--ease-exit"
      },
      "interrupt": "finish",
      "reduced": "instant",
      "frames": [
        {
          "source": "design/surfaces/layers.tsx",
          "frame": "deploy-dialog"
        }
      ],
      "consumers": [
        {
          "file": "ui/components/ui/Dialog.tsx",
          "match": "tailwind:transition-[opacity,scale]",
          "within": "Dialog"
        },
        {
          "file": "ui/components/ui/ConfirmDialog.tsx",
          "match": "tailwind:transition-[opacity,scale]",
          "within": "ConfirmDialog"
        }
      ]
    },
    "expand-collapse": {
      "exit": {
        "duration": "--motion-base"
      },
      "frames": [
        {
          "source": "design/modules/timeline.tsx",
          "frame": "timeline-fold"
        }
      ],
      "consumers": [
        {
          "file": "ui/components/TimelineEntries.tsx",
          "match": "motion:AnimatePresence",
          "within": "Fold"
        },
        {
          "file": "ui/components/TimelineEntries.tsx",
          "match": "motion:animate",
          "within": "Fold"
        },
        {
          "file": "ui/components/TimelineEntries.tsx",
          "match": "motion:exit",
          "within": "Fold"
        },
        {
          "file": "ui/product.css",
          "match": "css:.topology-section-content[data-state=\"open\"]"
        },
        {
          "file": "ui/product.css",
          "match": "css:.topology-section-content[data-state=\"closed\"]"
        },
        {
          "file": "ui/product.css",
          "match": "keyframes:topology-expand"
        },
        {
          "file": "ui/product.css",
          "match": "keyframes:topology-collapse"
        }
      ]
    },
    "highlight-follow": {
      "extends": "follow",
      "consumers": [
        {
          "file": "ui/components/ui/HoverScope.tsx",
          "match": "motion:animate",
          "within": "measure"
        },
        {
          "file": "ui/components/ui/style-HoverScope.css",
          "match": "css:.hover-highlight"
        }
      ]
    },
    "update-panel-entry": {
      "extends": "slide",
      "consumers": [
        {
          "file": "ui/components/AppUpdate.css",
          "match": "css:.update-panel"
        },
        {
          "file": "ui/components/AppUpdate.css",
          "match": "keyframes:update-panel-in"
        }
      ]
    },
    "control-feedback": {
      "kind": "transition",
      "action": "enter",
      "effect": "fade",
      "properties": [
        "background-color",
        "border-color",
        "color",
        "opacity",
        "transform"
      ],
      "parameters": {
        "duration": "--motion-fast",
        "easing": "--ease-enter"
      },
      "interrupt": "finish",
      "reduced": "instant",
      "consumers": [
        {
          "file": "ui/components/hosting/DataTable.css",
          "match": "css:.data-table-row"
        },
        {
          "file": "ui/components/navigation/NavCapsule.css",
          "match": "css:.navigation-capsule button"
        },
        {
          "file": "ui/components/ui/controls.css",
          "match": "css:.button"
        },
        {
          "file": "ui/components/ui/controls.css",
          "match": "css:.switch"
        },
        {
          "file": "ui/components/ui/controls.css",
          "match": "css:.switch-thumb"
        },
        {
          "file": "ui/components/ui/controls.css",
          "match": "css:.choice-pills .choice-option"
        },
        {
          "file": "ui/product.css",
          "match": "css:.capsule-icons button"
        },
        {
          "file": "ui/product.css",
          "match": "css:.hub-dot"
        },
        {
          "file": "ui/product.css",
          "match": "css:.hub-symbol"
        },
        {
          "file": "ui/product.css",
          "match": "css:.topology-arc-actions .arc-action-button"
        },
        {
          "file": "ui/product.css",
          "match": "css:.hub-arc-action"
        }
      ]
    },
    "disclosure-turn": {
      "kind": "transition",
      "action": "enter",
      "effect": "pop",
      "properties": [
        "transform"
      ],
      "parameters": {
        "duration": "--motion-base",
        "easing": "--ease-enter"
      },
      "interrupt": "finish",
      "reduced": "instant",
      "consumers": [
        {
          "file": "ui/coordination/center.css",
          "match": "css:.center-technical>summary>.icon"
        },
        {
          "file": "ui/mcp/Controls.css",
          "match": "css:.tag.disclosure"
        },
        {
          "file": "ui/product.css",
          "match": "css:.timeline-chevron"
        },
        {
          "file": "ui/product.css",
          "match": "css:.topology-section-trigger>.icon"
        }
      ]
    },
    "privacy-fade": {
      "extends": "fade",
      "consumers": [
        {
          "file": "ui/product.css",
          "match": "css:.pii"
        },
        {
          "file": "ui/product.css",
          "match": "keyframes:privacy-in"
        }
      ]
    },
    "loading-spin": {
      "kind": "ambient",
      "action": "loop",
      "effect": "spin",
      "properties": [
        "transform"
      ],
      "parameters": {
        "duration": "--motion-running",
        "easing": "--ease-enter"
      },
      "interrupt": "cancel",
      "reduced": "static",
      "consumers": [
        {
          "file": "ui/components/AppUpdate.css",
          "match": "css:.update-ring"
        },
        {
          "file": "ui/components/AppUpdate.css",
          "match": "keyframes:update-spin"
        },
        {
          "file": "ui/components/ui/Feedback.css",
          "match": "css:.ui-spinner"
        },
        {
          "file": "ui/components/ui/Feedback.css",
          "match": "keyframes:ui-spin"
        },
        {
          "file": "ui/product.css",
          "match": "css:.step-running .icon"
        },
        {
          "file": "ui/style.css",
          "match": "css:.spin"
        },
        {
          "file": "ui/style.css",
          "match": "keyframes:spin"
        }
      ]
    },
    "connection-flow": {
      "kind": "ambient",
      "action": "loop",
      "effect": "shimmer",
      "properties": [
        "stroke-dashoffset",
        "opacity"
      ],
      "parameters": {
        "duration": "--motion-running",
        "easing": "--ease-linear"
      },
      "interrupt": "cancel",
      "reduced": "static",
      "consumers": [
        {
          "file": "ui/product.css",
          "match": "css:.topology-wires :where(.primary[data-state=\"connecting\"]) .connecting-wire"
        },
        {
          "file": "ui/product.css",
          "match": "css:.topology-wires .right .connecting-wire"
        },
        {
          "file": "ui/product.css",
          "match": "keyframes:graph-connecting"
        },
        {
          "file": "ui/product.css",
          "match": "keyframes:activity-flow"
        }
      ]
    }
  }
}
