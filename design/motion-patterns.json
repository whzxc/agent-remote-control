  "patterns": {
    "aurora-border": {
      "kind": "ambient",
      "action": "loop",
      "effect": "aurora",
      "properties": ["--task-aurora-angle", "background"],
      "parameters": {"duration": "--motion-aurora", "easing": "--adg-motion-linear"},
      "interrupt": "cancel",
      "reduced": "static",
      "frames": [{"source": "design/components/task-card.tsx", "frame": "task-card-aurora"}],
      "consumers": [
        {"file": "ui/components/ui/TaskCard.css", "match": "css:.task-card[data-aurora]"},
        {"file": "ui/components/ui/TaskCard.css", "match": "keyframes:task-aurora"},
        {"file": "ui/components/HomepageTasks.tsx", "match": "attribute:data-aurora"}
      ]
    },
    "geometry-transition": {
      "kind": "layout",
      "action": "reflow",
      "effect": "size",
      "properties": ["x", "y", "width", "height"],
      "parameters": {"duration": "--motion-base", "easing": "--ease-enter"},
      "interrupt": "retarget",
      "reduced": "instant",
      "consumers": [
        {"file": "ui/motion/geometry.ts", "match": "motion:animate", "within": "to"}
      ]
    },
    "topology-geometry-spring": {
      "kind": "layout",
      "action": "reflow",
      "effect": "size",
      "properties": ["x", "y", "width", "height", "scale", "opacity"],
      "parameters": {"spring": "--motion-spring-topology"},
      "interrupt": "retarget",
      "reduced": "instant",
      "frames": [{"source": "design/modules/homepage-scene/index.tsx", "frame": "idle"}],
      "consumers": [
        {"file": "ui/topology/animate.ts", "match": "call:spring", "within": "TopologyAnimator"}
      ]
    },
    "agent-position-reflow": {
      "kind": "layout",
      "action": "reflow",
      "effect": "avoid",
      "properties": ["x", "y", "scale", "box-shadow"],
      "parameters": {"duration": "--motion-base", "easing": "--ease-enter"},
      "interrupt": "retarget",
      "reduced": "instant",
      "frames": [{"source": "design/modules/agent-settings.tsx", "frame": "agent-inventory-card"}],
      "consumers": [
        {"file": "ui/components/AgentsSettings.tsx", "match": "motion:layout", "within": "AgentCard"},
        {"file": "ui/components/AgentsSettings.tsx", "match": "motion:whileDrag", "within": "AgentCard"}
      ]
