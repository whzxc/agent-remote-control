{
  "name": "agent-remote-control",
  "version": "0.0.0",
  "description": "Connect Claude and ChatGPT to local coding agents through MCP and remote control",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "brand": "node tooling/brand.mjs",
    "check": "tsc --noEmit -p ui/tsconfig.json",
    "build": "vite build --config vite.config.ts && node tooling/build-native.mjs",
    "cache:prune": "node tooling/prune-build-cache.mjs",
    "pretest": "node tooling/prune-build-cache.mjs",
    "test": "cargo test --locked --manifest-path native/Cargo.toml --lib && node --test tests/control-mcp.test.ts",
    "posttest": "node tooling/prune-build-cache.mjs --keep=target/debug",
    "check:package": "node tooling/check-package.mjs",
    "dev:ui": "vite --config vite.config.ts",
    "dev": "node tooling/desktop-dev.mjs",
    "desktop:prepare": "node tooling/prepare-desktop.mjs",
    "desktop:build": "node tooling/desktop-build.mjs",
    "predesktop:check": "node tooling/build-native.mjs && node tooling/prune-build-cache.mjs",
    "desktop:check": "cargo check --manifest-path desktop/Cargo.toml",
    "postdesktop:check": "node tooling/prune-build-cache.mjs --keep=target/debug",
    "check:format": "cargo fmt --all -- --check",
    "precheck:native": "node tooling/build-native.mjs && node tooling/prune-build-cache.mjs",
    "check:native": "cargo check --manifest-path desktop/Cargo.toml",
    "postcheck:native": "node tooling/prune-build-cache.mjs --keep=target/debug",
    "release:stage": "node tooling/release.mjs stage",
    "release:finalize": "node tooling/release.mjs finalize",
    "release": "node tooling/release.mjs release"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@types/node": "26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whzxc/agent-remote-control.git"
  },
  "homepage": "https://github.com/whzxc/agent-remote-control#readme",
  "bugs": {
    "url": "https://github.com/whzxc/agent-remote-control/issues"
  },
  "keywords": [
    "claude",
    "codex",
    "mcp",
    "agent",
    "remote-control"
  ],
  "private": true
}
