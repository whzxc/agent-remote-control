{
  "name": "agent-remote-control",
  "version": "0.0.0",
  "description": "Connect Claude and ChatGPT to local coding agents through MCP and remote control",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "wt": "node tooling/worktree.mjs",
    "brand": "node tooling/brand.mjs",
    "check": "tsc --noEmit -p ui/tsconfig.json",
    "build": "vite build --config vite.config.ts && node tooling/build-native.mjs",
    "cache:prune": "node tooling/prune-build-cache.mjs",
    "pretest": "npm run check:tests",
    "test": "node tooling/test.mjs",
    "check:package": "node tooling/check-package.mjs",
    "dev:ui": "vite --config vite.config.ts",
    "dev": "node tooling/desktop-dev.mjs",
    "desktop:prepare": "node tooling/prepare-desktop.mjs",
    "desktop:build": "node tooling/desktop-build.mjs",
    "desktop:check": "node tooling/check-native.mjs",
    "check:format": "cargo fmt --all -- --check",
    "check:native": "node tooling/check-native.mjs",
    "release:stage": "node tooling/release.mjs stage",
    "release:finalize": "node tooling/release.mjs finalize",
    "release": "node tooling/release.mjs release",
    "check:relay": "npm --prefix relay-worker run check",
    "test:relay": "npm --prefix relay-worker test",
    "accept:updates": "node tooling/acceptance/updates.mjs",
    "accept:ui": "node tooling/acceptance/ui.mjs",
    "accept:remote": "node tooling/acceptance/remote.mjs",
    "check:tests": "node tooling/check-tests.mjs",
    "mutation:ui": "stryker run",
    "mutation:native": "node tooling/mutation-native.mjs",
    "test:churn": "node tooling/test-churn.mjs",
    "release:linux:setup": "node tooling/setup-linux-release.mjs",
    "dev:isolated": "node tooling/isolated-dev.mjs"
  },
  "devDependencies": {
    "@ast-grep/lang-rust": "^0.0.7",
    "@ast-grep/napi": "^0.51.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@stryker-mutator/core": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whzxc/agent-remote-control.git"
  },
  "homepage": "https://github.com/whzxc/agent-remote-control#readme",
  "bugs": {
    "url": "https://github.com/whzxc/agent-remote-control/issues"
  },
  "keywords": [
    "claude",
    "codex",
    "mcp",
    "agent",
    "remote-control"
  ],
  "private": true
}
