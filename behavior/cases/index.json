  "reachabilityGaps": [
    {
      "ruleId": "arc-instance-left-alone",
      "thenIds": [
        "instance-survives",
        "tasks-usable-there",
        "no-release-while-running"
      ],
      "seam": "Add a test-runner-owned macOS two-profile driver that identifies a window by PID, creation identity and AX window ID, reads its selected thread, and sends or archives a specified thread. Preserve both profiles and the daemon across a real Core restart or signed guest update."
    },
    {
      "ruleId": "instance-exit-unlocks-tasks",
      "thenIds": [
        "finished-continuable",
        "finished-archivable",
        "running-unlocks-after"
      ],
      "seam": "Give the guest driver per-thread accepted-send and archived-list readback with monotonic acknowledgement times on the main Desktop. Feed parent and child IDs and the case PID-exit or original terminal-event timestamp into the driver. Add a fixture barrier after the first eligible thread releases and before the remaining releases to hit partial recovery deterministically."
    },
    {
      "ruleId": "instance-exit-unlocks-tasks",
      "thenIds": [
        "running-not-interrupted",
        "running-status-shown",
        "reopen-shows-task"
      ],
      "seam": "Add a fixture-scoped independent-instance lifecycle source with two distinct profiles, exit while a controlled turn is gated, explicit natural completion/failure, and a recorded reopen destination. Bind the browser fixture to the same-build closed-active management projection. A real crash can already be induced by the guarded guest driver."
    },
    {
      "ruleId": "earlier-held-tasks-unlock",
      "thenIds": [
        "unlocked-without-action"
      ],
      "seam": "Provision an old signed ARC guest with verified still-held native threads and a ready signed successor. Install on the same running guest while preserving the daemon process; a copied history directory alone loses the lock."
    },
    {
      "ruleId": "foreign-holder-reported",
      "thenIds": [
        "holder-named",
        "steps-workable",
        "holder-untouched"
      ],
      "seam": "Provision a second disposable SSH client and expose its known peer, terminal and writer identity to the fixture driver. Execute each advertised manual recovery in that session. The local PTY contract covers one terminal and one completed task."
    },
    {
      "ruleId": "no-take-back-from-user",
      "thenIds": [
        "stays-with-user",
        "input-not-delivered",
        "in-use-reported"
      ],
      "seam": "Let a fixture dispatch on the independent local-daemon route, observe exit and unlock, then accept a user-marked turn in a second Desktop on its own writer. Record accepted user messages and steers on both routes. Add receipt-admission and pre-delivery barriers so the runner can restart Core or install an update before inspecting or replaying a write."
    }
  ]
}
