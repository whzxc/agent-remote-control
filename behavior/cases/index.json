  "reachabilityGaps": [
    {
      "ruleId": "arc-instance-left-alone",
      "thenIds": [
        "instance-survives",
        "tasks-usable-there",
        "no-release-while-running"
      ],
      "seam": "Add a test-runner-owned macOS two-profile driver that identifies a window by PID, creation identity and AX window ID, reads its selected thread, and sends or archives a specified thread. Preserve both profiles and the daemon across a real Core restart or signed guest update."
    },
    {
      "ruleId": "instance-exit-unlocks-tasks",
      "thenIds": [
        "own-hold-dropped",
        "handed-back",
        "holder-shown",
        "window-close-not-exit",
        "running-handed-back-after"
      ],
      "seam": "Provide a passive native per-connection subscription trace (client identity, thread, acknowledgement/disconnect, monotonic time) to time ARC release while a witness still holds the same daemon writer. Add a barrier after the first eligible release and independent PID-scoped close/show, parent-send and parent-archive actions with per-child archive readback. Provision a guest ChatGPT update that exits the recorded instance."
    },
    {
      "ruleId": "instance-exit-unlocks-tasks",
      "thenIds": [
        "running-not-interrupted",
        "running-status-shown",
        "reopen-shows-task"
      ],
      "seam": "Add a fixture-scoped independent-instance lifecycle source with two distinct profiles, exit while a controlled turn is gated, explicit natural completion/failure, and a recorded reopen destination. Bind the browser fixture to the same-build closed-active management projection. A real crash can already be induced by the guarded guest driver."
    },
    {
      "ruleId": "earlier-held-tasks-unlock",
      "thenIds": [
        "own-hold-dropped-at-start",
        "handed-back-or-holder"
      ],
      "seam": "Provision a guest old build with still-held native threads, a ready signed ARC successor, and a passive per-client subscription trace across startup. Retain the original daemon and independent witness to distinguish automatic ARC release from eventual lock clearance."
    },
    {
      "ruleId": "foreign-holder-reported",
      "thenIds": [
        "holder-named",
        "steps-workable",
        "holder-untouched"
      ],
      "seam": "Provision a second disposable SSH origin and compare its known parent/terminal evidence with the diagnosis. Use the guest subscribe command for the shared-server/unknown-client branch. Release from the same original witness connection and check its native acknowledgement after local observations."
    },
    {
      "ruleId": "no-take-back-from-user",
      "thenIds": [
        "stays-with-user",
        "input-not-delivered",
        "in-use-reported"
      ],
      "seam": "Let a fixture dispatch on the independent local-daemon route, observe process exit, a cleared writer and the handed-back mark, then accept a user-marked turn in a second Desktop on its own writer. Record accepted user messages and steers on both routes. Add receipt-admission and pre-delivery barriers so the runner can restart Core or install an update before inspecting or replaying a write."
    }
  ]
}
