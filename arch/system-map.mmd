    local["Desktop app · arc CLI"]
    fd["Front door<br/>listeners · auth · tunnels<br/>queue during Core swap"]
    state[("State directory<br/>sources · receipts · bindings")]
    hub["MCP hub<br/>downstream MCP servers"]
    core["Core<br/>op catalog · receipts · dispatch<br/>notifications · coordination · accounts"]
