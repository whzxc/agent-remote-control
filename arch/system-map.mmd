flowchart TB
  src["Control sources<br/>ChatGPT · Claude · other MCP clients"]
  net["Connections<br/>OpenAI Secure Tunnel · dedicated tunnel · relay"]
  subgraph HOST["ARC on this computer"]
    local["Desktop app · arc CLI<br/>Desktop: manual persisted Topology / Execution mode"]
    fd["Front door<br/>listeners · auth · tunnels<br/>queue during Core swap"]
    state[("State directory<br/>sources · receipts · bindings")]
    hub["MCP hub<br/>downstream MCP servers"]
    core["Core<br/>op catalog · receipts · dispatch<br/>notifications · coordination · accounts"]
  end
  subgraph EXEC["Agent execution"]
    codexd["Codex Desktop<br/>primary account"]
    appsrv["ARC App Server<br/>one per Codex account"]
    taskhost["task-host<br/>Claude Code · Cursor · Pi · dsh"]
  end
  native[("Native session stores<br/>CODEX_HOME · Claude projects")]
  subgraph MEMBERS["Member devices · Device link"]
    member["Paired member device · RIGHT tier 1<br/>peer listener · Core<br/>controller device = LEFT tier-1 source"]
    magent["Remote Agent · tier 2<br/>single Agent merges with device node"]
    maccount["Account / profile tier<br/>fold under pressure"]
    mstates["Static topology: node task-state badges only<br/>offline = unconfirmed · no live counts<br/>no task nodes / queues / task arcs"]
    mnative[("Member native session stores")]
    descendant["Further member devices<br/>nesting supported · cycle rejection<br/>one-hop render · protocol forwarding = false"]
  end
  src -->|"MCP guide / query / act · structures frozen<br/>ops gain device target argument"| net
